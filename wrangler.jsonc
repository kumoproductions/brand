{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brand-kumo-productions",
  "account_id": "d4c91a1108b91355b25550f061d21b2d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "routes": [{ "pattern": "brand.kumo.productions", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
