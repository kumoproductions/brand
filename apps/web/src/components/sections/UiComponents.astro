---
import SectionHeader from '../SectionHeader.astro';

const demos = [
  { title: 'Actions — Button / IconButton', path: 'components/actions/', src: '/components/actions/actions.card.html', height: 280 },
  { title: 'Forms — Input / Select / Checkbox / Radio / Switch', path: 'components/forms/', src: '/components/forms/forms.card.html', height: 350 },
  { title: 'Display — Card / Badge / Tag / KumoLogo', path: 'components/display/', src: '/components/display/display.card.html', height: 430 },
  { title: 'Navigation — Tabs', path: 'components/navigation/', src: '/components/navigation/navigation.card.html', height: 170 },
  { title: 'Feedback — Dialog / Toast / Tooltip', path: 'components/feedback/', src: '/components/feedback/feedback.card.html', height: 330 },
];
---

<section id="ds-components" class="section">
  <SectionHeader
    kicker="Design System Extension"
    page="12"
    title="UI Components"
    sub="ブランド規定から定義した標準UIセット(React+トークン参照)。以下は実動デモ — 操作できます。各コンポーネントは .jsx 実装+.d.ts(プロップ契約)+.prompt.md(使用例)の3点構成"
  />
  {
    demos.map((demo) => (
      <div class="demo">
        <div class="demo-head">
          <span class="demo-title">{demo.title}</span>
          <span class="demo-path">{demo.path}</span>
        </div>
        <iframe src={demo.src} title={demo.title} height={demo.height} />
      </div>
    ))
  }
  <div class="prose" style="margin-top: 28px;">
    <p style="font-size: 12px; color: var(--text-secondary); max-width: none;">
      配色・状態はガイドライン準拠: プライマリ=Base
      black、アクセント=Night sky blue、フォーカスリング=Sky
      blue、ヘアライン基調・150msの控えめなモーション。状態色(--success / --warning /
      --danger)はUI上の必要から、パレットに調和するoklch値で追加(最小限の使用)。
    </p>
  </div>
</section>
