---
import SectionHeader from '../SectionHeader.astro';

const palette = [
  { group: 'Base color (White)', name: 'Base white', rgb: 'R255 G255 B255', hex: '#FFFFFF', cmyk: 'C00 M00 Y00 K00', outline: true },
  { group: 'Base color (White)', name: 'Cloud white', rgb: 'R247 G247 B247', hex: '#F7F7F7', cmyk: 'C05 M05 Y05 K05', outline: true },
  { group: 'Base color (Gray)', name: 'Cloudiness gray', rgb: 'R106 G110 B113', hex: '#6A6E71', cmyk: 'C65 M55 Y50 K05', outline: false },
  { group: 'Base color (Black)', name: 'Space black', rgb: 'R30 G30 B30', hex: '#1E1E1E', cmyk: 'C85 M80 Y80 K60', outline: false },
  { group: 'Base color (Black)', name: 'Base black', rgb: 'R0 G0 B0', hex: '#000000', cmyk: 'C20 M20 Y20 K100', outline: false },
  { group: 'Highlight color', name: 'Sky blue', rgb: 'R100 G173 B212', hex: '#64ADD4', cmyk: 'C60 M20 Y10 K00', outline: false },
  { group: 'Highlight color', name: 'Night sky blue', rgb: 'R30 G75 B107', hex: '#1E4B6B', cmyk: 'C90 M70 Y45 K10', outline: false },
];

const tokens = [
  { chip: 'background: #FFFFFF; border: 1px solid #E9EAEB;', name: '--surface-page / --surface-card', src: 'Base white #FFFFFF', use: '画面・カードの地' },
  { chip: 'background: #F7F7F7; border: 1px solid #E9EAEB;', name: '--surface-sunken', src: 'Cloud white #F7F7F7', use: '沈み面・ホバー背景' },
  { chip: 'background: #1E1E1E;', name: '--surface-inverse', src: 'Space black #1E1E1E', use: 'ダーク面・反転カード' },
  { chip: 'background: #000000;', name: '--text-primary', src: 'Base black #000000', use: '本文・見出し' },
  { chip: 'background: #6A6E71;', name: '--text-secondary', src: 'Cloudiness gray #6A6E71', use: '補足・ラベル・キャプション' },
  { chip: 'background: #FFFFFF; border: 1px solid #E9EAEB;', name: '--text-inverse / --text-on-accent', src: 'Base white #FFFFFF', use: '反転面・アクセント上の文字' },
  { chip: 'background: #1E4B6B;', name: '--accent', src: 'Night sky blue #1E4B6B', use: 'リンク・強調アクション' },
  { chip: 'background: #64ADD4;', name: '--accent-soft', src: 'Sky blue #64ADD4', use: 'ホバー・フォーカスの強調' },
  { chip: 'background: rgba(100, 173, 212, 0.14); border: 1px solid #E9EAEB;', name: '--accent-soft-bg', src: 'Sky blue 14%', use: '選択・ハイライト背景' },
  { chip: 'background: #FFFFFF; border: 1px solid #C9CCCE;', name: '--border-default / --border-strong', src: '#E9EAEB / #C9CCCE(gray由来)', use: 'ヘアライン区切り / 入力・アウトライン枠' },
  { chip: 'background: #FFFFFF; box-shadow: 0 0 0 2px rgba(100, 173, 212, 0.55);', name: '--focus-ring', src: 'Sky blue 55%', use: 'フォーカスリング(2px)' },
  { chip: 'background: rgba(30, 30, 30, 0.5);', name: '--scrim', src: 'Space black 50%', use: 'モーダル・オーバーレイ背景' },
  { chip: 'background: oklch(0.5 0.13 25);', name: '--danger / --danger-bg', src: 'oklch(0.5 0.13 25) — 追加色', use: 'エラー・破壊的操作(ブランド外・最小使用)' },
  { chip: 'background: oklch(0.55 0.1 155);', name: '--success / --success-bg', src: 'oklch(0.55 0.1 155) — 追加色', use: '完了・成功状態(ブランド外・最小使用)' },
  { chip: 'background: oklch(0.58 0.12 80);', name: '--warning / --warning-bg', src: 'oklch(0.58 0.12 80) — 追加色', use: '注意・要確認状態(ブランド外・最小使用)' },
];
---

<section id="color" class="section">
  <SectionHeader kicker="Color Style guideline" page="08" title="Color Style" sub="カラー">
    <p>これらのカラーは kumo.productions™ におけるアイデンティティを確立するための要素です。</p>
    <p>雲やその水滴の集まりを模したシンボルに合わせ、それぞれ空をイメージした特別なカラーで構成されています。</p>
    <p>
      これらはそれぞれの明度・彩度・色相を変えてはならず、均一に塗られている必要があります。また、後述する組み合わせの規定に従い、配色してください。
    </p>
  </SectionHeader>
  <div class="swatch-grid">
    {
      palette.map((color) => (
        <button class="swatch" type="button" data-copy={color.hex} title={`${color.hex} をコピー`}>
          <span class:list={['swatch-chip', { 'chip-outline': color.outline }]} style={`background: ${color.hex};`} />
          <span>
            <span class="swatch-group">{color.group}</span>
            <span class="swatch-name" style="display: block;">
              {color.name}
            </span>
            <span class="swatch-codes" style="display: block;">
              {color.rgb}
              <br />
              {color.hex}
              <br />
              {color.cmyk}
            </span>
          </span>
          <span class="swatch-copy">Copy HEX</span>
        </button>
      ))
    }
  </div>
  <p class="block-label">Semantic colors — Extension / セマンティックカラー(拡張定義)</p>
  <div class="prose">
    <p>
      ベース7色に役割を与えたエイリアス。UI・制作物では原則こちらを参照します(定義:
      tokens/colors.css)。ハイライト2色の運用ルール(グレー上禁止・低コントラスト禁止)はセマンティック層でも同様です。
    </p>
  </div>
  <div class="tok-table">
    <div class="tok-head"><span></span><span>Token</span><span>Source</span><span>Usage</span></div>
    {
      tokens.map((token) => (
        <div class="tok-row">
          <span class="tok-chip" style={token.chip} />
          <span class="tok-name">{token.name}</span>
          <span class="tok-src">{token.src}</span>
          <span class="tok-use">{token.use}</span>
        </div>
      ))
    }
  </div>
  <div class="asset-actions" style="margin-top: 24px;">
    <button class="chip-btn" type="button" data-copy-src="/tokens/colors.css">
      <span class="copy-label">Copy tokens/colors.css</span>
    </button>
    <a class="chip-btn" href="/tokens/colors.css" download="kumo-colors.css">colors.css ↓</a>
  </div>
</section>
