---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'kumo.productions™ Branding Standards',
  description = 'kumo.productions™ の公式ブランドポータル。Branding Standards v1.0 — シンボル、ロゴタイプ、タイポグラフィ、カラー、使用例、デザイントークン。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kumo.productions™" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/PPObjectSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline>
      // Set the theme before first paint to avoid a light-mode flash.
      if (localStorage.getItem('kumo-theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      // ------------------------------------------------------------- theme
      const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

      // Component demo iframes without an explicit ?theme= follow the page
      // theme via postMessage (see components/**/*.card.html).
      function applyTheme(dark: boolean) {
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
        for (const frame of document.querySelectorAll('iframe')) {
          frame.contentWindow?.postMessage({ kumoTheme: dark ? 'dark' : 'light' }, '*');
        }
        const button = document.getElementById('theme-toggle');
        if (button) {
          button.textContent = dark ? 'Dark' : 'Light';
          button.setAttribute('aria-pressed', String(dark));
        }
      }

      applyTheme(isDark());

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = !isDark();
        localStorage.setItem('kumo-theme', next ? 'dark' : 'light');
        applyTheme(next);
      });

      for (const frame of document.querySelectorAll('iframe')) {
        frame.addEventListener('load', () => {
          frame.contentWindow?.postMessage({ kumoTheme: isDark() ? 'dark' : 'light' }, '*');
        });
      }

      // ------------------------------------------------------------- copy
      function showCopied(el: Element, ok: boolean) {
        const label = el.querySelector('.copy-label, .swatch-copy') ?? el;
        const original = label.textContent;
        label.textContent = ok ? 'Copied' : 'Failed';
        el.setAttribute('data-copied', '');
        setTimeout(() => {
          label.textContent = original;
          el.removeAttribute('data-copied');
        }, 1400);
      }

      document.addEventListener('click', async (event) => {
        const el = (event.target as HTMLElement).closest('[data-copy], [data-copy-src]');
        if (!el) return;
        try {
          const src = el.getAttribute('data-copy-src');
          const text = src ? await (await fetch(src)).text() : (el.getAttribute('data-copy') ?? '');
          await navigator.clipboard.writeText(text);
          showCopied(el, true);
        } catch {
          showCopied(el, false);
        }
      });

      // -------------------------------------------------------- scroll spy
      const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
      const links = new Map(
        [...document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')].map((link) => [
          link.getAttribute('href')?.slice(1) ?? '',
          link,
        ])
      );
      const visible = new Set<string>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          const current = sections.find((section) => visible.has(section.id));
          for (const [id, link] of links) link.classList.toggle('is-active', id === current?.id);
        },
        { rootMargin: '-10% 0px -70% 0px' }
      );
      for (const section of sections) spy.observe(section);
    </script>
  </body>
</html>
