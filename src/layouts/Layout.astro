---
import '../styles/global.css';
import Exporter from '../components/Exporter.astro';
import SphereOrnament from '../components/SphereOrnament.astro';

interface Props {
  lang?: 'ja' | 'en';
  title?: string;
  description?: string;
}

const { lang = 'ja' } = Astro.props;
const {
  title = 'kumo.productions™ Branding Standards',
  description = lang === 'en'
    ? 'The official brand portal of kumo.productions™. Branding Standards v1.0 — symbol, logotype, typography, color, usage examples, and design tokens.'
    : 'kumo.productions™ の公式ブランドポータル。Branding Standards v1.0 — シンボル、ロゴタイプ、タイポグラフィ、カラー、使用例、デザイントークン。',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kumo.productions™" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="ja" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly version" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline>
      // Set the theme before first paint to avoid a light-mode flash.
      if (localStorage.getItem('kumo-theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <SphereOrnament />
    <slot />
    <dialog id="lightbox" class="lightbox" aria-label="Figure viewer">
      <button class="lightbox-close" type="button" aria-label="Close">✕</button>
      <div class="lightbox-frame">
        <img class="lightbox-img" alt="" />
      </div>
      <p class="lightbox-cap"></p>
    </dialog>
    <Exporter />
    <script>
      // ------------------------------------------------------------- theme
      const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

      // Component demo iframes without an explicit ?theme= follow the page
      // theme via postMessage (see components/**/*.card.html).
      function applyTheme(dark: boolean) {
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
        for (const frame of document.querySelectorAll('iframe')) {
          frame.contentWindow?.postMessage({ kumoTheme: dark ? 'dark' : 'light' }, '*');
        }
        const button = document.getElementById('theme-toggle');
        if (button) {
          button.textContent = dark ? 'Dark' : 'Light';
          button.setAttribute('aria-pressed', String(dark));
        }
      }

      applyTheme(isDark());

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = !isDark();
        localStorage.setItem('kumo-theme', next ? 'dark' : 'light');
        applyTheme(next);
      });

      for (const frame of document.querySelectorAll('iframe')) {
        frame.addEventListener('load', () => {
          frame.contentWindow?.postMessage({ kumoTheme: isDark() ? 'dark' : 'light' }, '*');
          // Same-origin demo cards render after babel compiles, so the height
          // attribute is only an initial estimate — track the real content
          // height and keep the frame exactly that tall (no inner scrollbar).
          const doc = frame.contentDocument;
          if (!doc?.body) return;
          // Clip instead of scrolling inside the frame — the observer keeps
          // the frame at the content's height, so nothing is ever hidden.
          doc.documentElement.style.overflow = 'hidden';
          const fit = () => {
            const height = Math.ceil(doc.body.getBoundingClientRect().height);
            if (height) frame.style.height = `${height}px`;
          };
          fit();
          new ResizeObserver(fit).observe(doc.body);
        });
      }

      // ------------------------------------------------------------- copy
      function showCopied(el: Element, ok: boolean) {
        const label = el.querySelector('.copy-label, .swatch-copy') ?? el;
        const original = label.textContent;
        label.textContent = ok ? 'Copied' : 'Failed';
        el.setAttribute('data-copied', '');
        setTimeout(() => {
          label.textContent = original;
          el.removeAttribute('data-copied');
        }, 1400);
      }

      document.addEventListener('click', async (event) => {
        const el = (event.target as HTMLElement).closest('[data-copy], [data-copy-src]');
        if (!el) return;
        try {
          const src = el.getAttribute('data-copy-src');
          const text = src ? await (await fetch(src)).text() : (el.getAttribute('data-copy') ?? '');
          await navigator.clipboard.writeText(text);
          showCopied(el, true);
        } catch {
          showCopied(el, false);
        }
      });

      // --------------------------------------------------------- lightbox
      const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
      const lightboxImg = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
      const lightboxCap = lightbox.querySelector('.lightbox-cap') as HTMLElement;

      function openLightbox(img: HTMLImageElement) {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        // White artwork comes from a dark plate — keep the frame dark too.
        const dark = !!img.closest('.plate-dark, .ornament-demo');
        lightbox.querySelector('.lightbox-frame')?.classList.toggle('lightbox-frame-dark', dark);
        const figcaption = img.closest('figure')?.querySelector('figcaption');
        const parts = figcaption
          ? [...figcaption.children].map((child) => child.textContent?.trim() ?? '').filter(Boolean)
          : [];
        lightboxCap.textContent = parts.join(' — ') || img.alt;
        lightbox.showModal();
      }

      for (const plate of document.querySelectorAll<HTMLElement>('.fig-plate')) {
        const img = plate.querySelector('img');
        if (!img) continue;
        plate.setAttribute('role', 'button');
        plate.tabIndex = 0;
        plate.addEventListener('click', () => openLightbox(img));
        plate.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openLightbox(img);
          }
        });
      }

      // Any click inside the dialog (backdrop, frame, or image) closes it.
      lightbox.addEventListener('click', () => lightbox.close());

      // --------------------------------------------------------- exporter
      const exporter = document.getElementById('exporter') as HTMLDialogElement;
      const exAsset = document.getElementById('ex-asset') as HTMLSelectElement;
      const exTone = document.getElementById('ex-tone') as HTMLSelectElement;
      const exTm = document.getElementById('ex-tm') as HTMLInputElement;
      const exFormat = document.getElementById('ex-format') as HTMLSelectElement;
      const exWidth = document.getElementById('ex-width') as HTMLSelectElement;
      const exQuality = document.getElementById('ex-quality') as HTMLSelectElement;
      const exBg = document.getElementById('ex-bg') as HTMLSelectElement;
      const exPreview = exporter.querySelector('.exporter-preview') as HTMLElement;
      const exImg = document.getElementById('ex-img') as HTMLImageElement;
      const exUrl = document.getElementById('ex-url') as HTMLElement;
      const exCopyUrl = document.getElementById('ex-copy-url') as HTMLElement;
      const exDownload = document.getElementById('ex-download') as HTMLAnchorElement;
      const exCopySvg = document.getElementById('ex-copy-svg') as HTMLElement;
      const exSvgLink = document.getElementById('ex-svg') as HTMLAnchorElement;

      function exStem(): string {
        const option = exAsset.selectedOptions[0];
        const tm =
          option.dataset.tm === 'required' || (option.dataset.tm === 'optional' && exTm.checked);
        const tone = option.dataset.tone === 'true' ? `-${exTone.value}` : '';
        return `${option.value}${tm ? '-tm' : ''}${tone}`;
      }

      // Renders the exact URL being exported; the fetch warms the edge cache.
      function exUpdate() {
        const option = exAsset.selectedOptions[0];
        exTm.disabled = option.dataset.tm !== 'optional';
        if (option.dataset.tm === 'required') exTm.checked = true;
        if (option.dataset.tm === 'none') exTm.checked = false;
        exTone.disabled = option.dataset.tone !== 'true';

        const stem = exStem();
        const params = new URLSearchParams();
        if (exWidth.value) params.set('w', exWidth.value);
        if (exQuality.value) params.set('q', exQuality.value);
        if (exBg.value) params.set('bg', exBg.value);
        const query = params.toString();
        const path = `/i/${stem}.${exFormat.value}${query ? `?${query}` : ''}`;

        exImg.src = path;
        // White-tone artwork vanishes on the light plate unless a background
        // is baked into the raster itself.
        exPreview.classList.toggle(
          'plate-dark',
          !exTone.disabled && exTone.value === 'white' && !exBg.value
        );
        exUrl.textContent = location.origin + path;
        exCopyUrl.setAttribute('data-copy', location.origin + path);
        exDownload.href = path;
        exDownload.setAttribute(
          'download',
          `kumo-${stem}${exWidth.value ? `-${exWidth.value}w` : ''}.${exFormat.value}`
        );
        const svgPath = `/content/${option.dataset.family}/svg/${stem}.svg`;
        exCopySvg.setAttribute('data-copy-src', svgPath);
        exSvgLink.href = svgPath;
        exSvgLink.setAttribute('download', `kumo-${stem}.svg`);
      }

      for (const control of [exAsset, exTone, exTm, exFormat, exWidth, exQuality, exBg]) {
        control.addEventListener('change', exUpdate);
      }

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest('[data-export]');
        if (!trigger) return;
        const stem = trigger.getAttribute('data-export') ?? '';
        const tone = stem.match(/-(black|white)$/)?.[1];
        let base = tone ? stem.slice(0, -(tone.length + 1)) : stem;
        const tm = base.endsWith('-tm');
        if (tm) base = base.slice(0, -3);
        exAsset.value = base;
        if (tone) exTone.value = tone;
        exTm.checked = tm;
        exUpdate();
        exporter.showModal();
      });

      exporter.querySelector('.exporter-close')?.addEventListener('click', () => exporter.close());
      // Backdrop click closes; clicks inside the panel land on children.
      exporter.addEventListener('click', (event) => {
        if (event.target === exporter) exporter.close();
      });

      // -------------------------------------------------------- scroll spy
      const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
      const links = new Map(
        [...document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')].map((link) => [
          link.getAttribute('href')?.slice(1) ?? '',
          link,
        ])
      );
      const visible = new Set<string>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          const current = sections.find((section) => visible.has(section.id));
          for (const [id, link] of links) link.classList.toggle('is-active', id === current?.id);
        },
        { rootMargin: '-10% 0px -70% 0px' }
      );
      for (const section of sections) spy.observe(section);
    </script>
  </body>
</html>
