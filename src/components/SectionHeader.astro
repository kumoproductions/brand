---
interface Props {
  kicker?: string;
  page?: string;
  title: string;
  sub?: string;
  /* Semantic tone for the sub label (Do/Don't language — see .tone-* in global.css). */
  tone?: 'do' | 'dont';
}

const { kicker, page, title, sub, tone } = Astro.props;
---

<header class="s-head">
  {kicker && <p class="kicker">{kicker}</p>}
  <div class="s-title-row">
    {page && <span class="page-badge">{page}</span>}
    <h2 class="s-title">{title}</h2>
    {sub && <span class:list={['s-sub', tone && `tone-${tone}`]}>{sub}</span>}
  </div>
  {
    Astro.slots.has('default') && (
      <div class="prose s-lede">
        <slot />
      </div>
    )
  }
</header>
