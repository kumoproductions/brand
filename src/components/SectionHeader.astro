---
interface Props {
  kicker?: string;
  page?: string;
  title: string;
  sub?: string;
}

const { kicker, page, title, sub } = Astro.props;
---

<header class="s-head">
  {kicker && <p class="kicker">{kicker}</p>}
  <div class="s-title-row">
    {page && <span class="page-badge">{page}</span>}
    <h2 class="s-title">{title}</h2>
  </div>
  {sub && <p class="s-sub">{sub}</p>}
  {
    Astro.slots.has('default') && (
      <div class="prose s-lede">
        <slot />
      </div>
    )
  }
</header>
