---
import AssetCard from '../AssetCard.astro';
import Figure from '../Figure.astro';
import SectionHeader from '../SectionHeader.astro';
import SphereGlyph from '../SphereGlyph.astro';

const SPHERES = ['sphere-11', 'sphere-7', 'sphere-5', 'sphere-3'];

interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;
const en = lang === 'en';

const t = en
  ? {
      sub: 'Construction system',
      lede: 'The symbol is composed of four spheres of different sizes, each of which is in turn built from particles that express its shading.',
      spheres:
        'Four sizes, 11, 7, 5, and 3 grid cells in diameter. Within a single symbol, each size may be used at most once.',
      particles: 'The particles that make up each sphere use seven object sizes to express its shading.',
      premiseTerm: 'Premise',
      premise: 'Let one side of the grid be 15a.',
      r1: 'Composed of seven squares with sides of 3a(n+1) (1≤n≤7, where n is a natural number),',
      r2: 'with every corner rounded at a radius of 2a.',
      r3: 'Place them on a grid of 15a squares, always along the diagonal.',
      rDash: 'Construct the connections between particles as follows.',
      r4: 'Connections are built with a fillet radius of 1.5a.',
      r5: 'Whenever a particle of size 5≤n is diagonally adjacent to one of size 3≤n, they must be connected.',
      r6: 'As an exception, a particle on the outer edge may connect to just one adjacent particle.',
      capSpheres: 'Composed of four sizes: 11, 7, 5, and 3 grid cells in diameter.',
      capParticleSpec: 'Seven squares with sides of 3a(n+1) (1≤n≤7). Every corner is rounded at a radius of 2a.',
      capRadius: 'Placed on a grid of 15a squares, always along the diagonal. Connections use a 1.5a fillet radius.',
      capConnExamples: 'Whenever a particle of size 5≤n is diagonally adjacent to one of size 3≤n, they must be connected.',
      capConnClouds: 'As an exception, a particle on the outer edge may connect to just one adjacent particle.',
      compLabel: 'Composition examples 1–6',
      compProse:
        'The symbol is composed of four differently sized spheres arranged on the prescribed grid. Only their pattern, proportions, and tonal values define the identity — their individual layout may be arranged freely within the following rules.',
      cap1: 'A composition that does not use every sphere still counts as the symbol; there are no special restrictions on which spheres to use.',
      cap2: 'However, spheres of the same size must not appear more than once within a single identity.',
      cap3: 'Do not change the size or proportions of individual spheres within a single identity.',
      cap4: 'Spheres that form a single identity must be placed on the same grid.',
      cap5: 'The patterns of adjacent spheres must align, with every particle positioned along the 45-degree diagonal.',
      cap6: 'Shading must assume a single light source, or the direction of shading must converge on a single point.',
      ornLabel: 'Corner ornament',
      ornProse:
        'A treatment that uses a single sphere as an ornament, as seen on kumo.productions™ OGP images and at the top of web pages. In addition to the construction rules above, follow the rules below. This portal applies it at the top right of the page.',
      orn1: 'A single sphere may be placed in the top-right corner of a surface, partially cropped (bled off) by the top or right edge.',
      orn2: 'Use one of the four defined spheres on its own; horizontal mirroring is allowed. Rotation is limited to right angles relative to the medium.',
      orn3: 'Use at most one ornament per surface, and never overlap it with the logotype or body text.',
      orn4: 'Color it as a single flat fill following the Color Style rules, keeping sufficient contrast with the background.',
      ornCap: 'OGP 1200×630 — sphere_3 mirrored / top-right bleed',
    }
  : {
      sub: '構成システム',
      lede: 'このシンボルロゴは4つの大きさの異なるスフィアより構成され、また、それぞれはその陰影を表現するパーティクルによって構成されます。',
      spheres:
        '直径 11マス、7マス、5マス、3マスの4つの異なる大きさで構成され、それぞれは同一シンボルでは一種類につき一つまでしか使用できません。',
      particles: '各スフィアを構成するパーティクルについて、その陰影を表現するため、7種類の異なる大きさのオブジェクトを使用します。',
      premiseTerm: '前提',
      premise: 'グリッドの一辺を 15a とする。',
      r1: '一辺 3a(n+1)(1≦n≦7)※nは自然数でなければならない からなる、7つの正方形で構成され、',
      r2: 'いずれの角も半径 2a の角丸で設定します。',
      r3: 'また、一辺 15a の正方形からなるグリッド上に設置し、必ず対角線上に設置しなければなりません。',
      rDash: 'また、各パーティクルの接続について以下に従い構成してください。',
      r4: '接続部は 1.5a の角丸で構成されます。',
      r5: '5≦n の大きさのパーティクルが、3≦n の斜めに隣接する場合すべて接続しなければなりません。',
      r6: 'ただし、外周に位置するパーティクルのみ、隣接する単一のパーティクルと接続が可能です。',
      capSpheres: '直径 11マス、7マス、5マス、3マスの4つの異なる大きさで構成されます。',
      capParticleSpec: '一辺 3a(n+1)(1≦n≦7)からなる7つの正方形。いずれの角も半径 2a の角丸で設定します。',
      capRadius: '一辺 15a の正方形からなるグリッド上に、必ず対角線上に設置。接続部は 1.5a の角丸で構成されます。',
      capConnExamples: '5≦n の大きさのパーティクルが、3≦n の斜めに隣接する場合すべて接続しなければなりません。',
      capConnClouds: 'ただし、外周に位置するパーティクルのみ、隣接する単一のパーティクルと接続が可能です。',
      compLabel: 'Composition examples 1–6 / 構成例',
      compProse:
        'このシンボルは、規定されたグリッド上に配置される、4つの大きさの異なるそれぞれのスフィアより構成され、そのパターン、比率、濃淡のみをアイデンティティとして定め、その個別のレイアウトについては以下の規定に則って自由に配置することができます。',
      cap1: 'すべてのスフィアを使用していなくてもシンボルとして認め、使用する各スフィアに特別な制限はありません。',
      cap2: 'ただし、同じ大きさのスフィアは同一アイデンティティ上に複数同時に配置してはいけません。',
      cap3: '同一のアイデンティティとして存在するスフィアのサイズや比率を個別に変更してはいけません。',
      cap4: '同一のアイデンティティとして存在するスフィアは同一のグリッド上に配置しなければなりません。',
      cap5: '隣接するスフィア同士のパターンは必ず揃えなければならず、それぞれの全てのパーティクルが45度の斜め方向に対応して配置されなければなりません。',
      cap6: 'スフィアの陰影は、光源の位置を一つとするか、陰影の方向は必ず一点に設定しなければなりません。',
      ornLabel: 'Corner ornament / コーナーオーナメント',
      ornProse:
        'kumo.productions™ の OGP や Web ページ上部にみられる、スフィア単体をあしらいとして用いる構成です。上記の構成規定に加え、以下に従ってください。本ポータルでもページ右上に適用しています。',
      orn1: '単一のスフィアを、面の右上隅に上端または右端で部分的に見切れるよう(裁ち落とし)配置することができます。',
      orn2: 'スフィアは規定の4種のうち一種を単体で使用し、左右反転を許容します。回転は媒体基準の直角単位に限ります。',
      orn3: '一つの面につき一箇所までとし、ロゴタイプや本文と重ねてはいけません。',
      orn4: 'カラーは Color Style の規定に従い単色とし、背景と十分なコントラストを保ってください。',
      ornCap: 'OGP 1200×630 — sphere_3 ミラー / 右上裁ち落とし',
    };
---

<section id="sym-systems" class="section">
  <SectionHeader
    kicker="The kumo.productions™ Symbol Guidelines"
    page="04"
    title="The kumo™ Symbol — Systems"
    sub={t.sub}
  >
    <p class:list={{ en }}>{t.lede}</p>
  </SectionHeader>
  <div class="rules">
    <div class="rule">
      <span class="rule-term">SPHERES</span>
      <span class="rule-desc">{t.spheres}</span>
    </div>
    <div class="rule">
      <span class="rule-term">PARTICLES</span>
      <span class="rule-desc">{t.particles}</span>
    </div>
    <div class="rule">
      <span class="rule-term">{t.premiseTerm}</span>
      <span class="rule-desc">{t.premise}</span>
    </div>
    <div class="rule">
      <span class="rule-term">1.</span>
      <span class="rule-desc">{t.r1}</span>
    </div>
    <div class="rule">
      <span class="rule-term">2.</span>
      <span class="rule-desc">{t.r2}</span>
    </div>
    <div class="rule">
      <span class="rule-term">3.</span>
      <span class="rule-desc">{t.r3}</span>
    </div>
    <div class="rule">
      <span class="rule-term">—</span>
      <span class="rule-desc">{t.rDash}</span>
    </div>
    <div class="rule">
      <span class="rule-term">4.</span>
      <span class="rule-desc">{t.r4}</span>
    </div>
    <div class="rule">
      <span class="rule-term">5.</span>
      <span class="rule-desc">{t.r5}</span>
    </div>
    <div class="rule">
      <span class="rule-term">6.</span>
      <span class="rule-desc">{t.r6}</span>
    </div>
  </div>
  <div class="fig-grid cols-2">
    <Figure
      span
      plateH="320px"
      src="/fig-svg/sys-spheres.svg"
      alt="SPHERES base compositions"
      mono="SPHERES — 11 / 7 / 5 / 3, 4, 7"
      ja={t.capSpheres}
    />
    <Figure
      src="/fig-svg/sys-particle-spec.svg"
      alt="PARTICLES size specification"
      num="1. 2."
      mono="PARTICLES — 3a+3an (1≤n≤7) / 2a"
      ja={t.capParticleSpec}
    />
    <Figure
      src="/fig-svg/sys-connection-radius.svg"
      alt="Connection fillet radius 1.5a"
      num="3. 4."
      mono="15a / 1.5a"
      ja={t.capRadius}
    />
    <Figure
      span
      plateH="210px"
      src="/fig-svg/sys-connection-examples.svg"
      alt="Connected and not connected judgments"
      num="5."
      mono="Example of no connection / Example of connection — 5≦n / 3≦n"
      ja={t.capConnExamples}
    />
    <Figure
      span
      plateH="240px"
      src="/fig-svg/sys-connection-clouds.svg"
      alt="Connection examples in composition"
      num="6."
      mono="Connected / Not connected"
      ja={t.capConnClouds}
    />
  </div>
  <p class="block-label">{t.compLabel}</p>
  <div class="prose">
    <p class:list={{ en }}>{t.compProse}</p>
  </div>
  <div class="fig-grid cols-3" style="--plate-h: 230px;">
    <Figure
      span
      plateH="290px"
      src="/fig-svg/systems-1.svg"
      alt="Composition system 1 — scale range"
      num="1."
      ja={t.cap1}
    />
    <Figure src="/fig-svg/systems-2.svg" alt="Composition system 2" num="2." ja={t.cap2} />
    <Figure src="/fig-svg/systems-3.svg" alt="Composition system 3" num="3." ja={t.cap3} />
    <Figure src="/fig-svg/systems-4.svg" alt="Composition system 4" num="4." ja={t.cap4} />
    <Figure src="/fig-svg/systems-5.svg" alt="Composition system 5" num="5." ja={t.cap5} />
    <Figure src="/fig-svg/systems-6.svg" alt="Composition system 6" num="6." ja={t.cap6} />
  </div>
  <p class="block-label">{t.ornLabel}</p>
  <div class="prose">
    <p class:list={{ en }}>{t.ornProse}</p>
  </div>
  <div class="rules">
    <div class="rule">
      <span class="rule-term">1.</span>
      <span class="rule-desc">{t.orn1}</span>
    </div>
    <div class="rule">
      <span class="rule-term">2.</span>
      <span class="rule-desc">{t.orn2}</span>
    </div>
    <div class="rule">
      <span class="rule-term">3.</span>
      <span class="rule-desc">{t.orn3}</span>
    </div>
    <div class="rule">
      <span class="rule-term">4.</span>
      <span class="rule-desc">{t.orn4}</span>
    </div>
  </div>
  <figure class="fig" style="margin-top: 40px;">
    <div class="ornament-demo" aria-hidden="true">
      <div class="ornament-demo-sphere"><SphereGlyph mirrored /></div>
    </div>
    <figcaption class="fig-cap">
      <span class="cap-mono">{t.ornCap}</span>
    </figcaption>
  </figure>
  <p class="block-label">{en ? 'Sphere assets' : 'Sphere assets / スフィア素材'}</p>
  <div class="asset-grid">
    {
      SPHERES.map((stem) => (
        <AssetCard
          file={`${stem}.svg`}
          src={`/content/sphere/svg/${stem}.svg`}
          alt={`kumo™ ${stem}`}
          label={`${stem}.svg`}
          stem={stem}
        />
      ))
    }
  </div>
</section>
