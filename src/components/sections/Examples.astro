---
import Figure from '../Figure.astro';
import SectionHeader from '../SectionHeader.astro';
import { formatSize, getStaticGroups } from '../../utils/assetLibrary';

interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;
const en = lang === 'en';

const t = en
  ? {
      sub: 'Applications (names and contact details are placeholders)',
      onScreen: 'On-screen',
      print: 'Print',
    }
  : {
      sub: '使用例(氏名・連絡先等はダミー表記)',
      onScreen: 'On-screen / 映像',
      print: 'Print / 印刷物',
    };
---

<section id="examples" class="section">
  <SectionHeader kicker="Usage Examples" page="11" title="Usage Examples" sub={t.sub} />
  <p class="block-label" style="margin-top: 40px;">{t.onScreen}</p>
  <div class="fig-grid cols-3" style="--plate-h: 210px;">
    <Figure src="/fig-svg/ex-onscreen-169.svg" alt="16:9 end card" mono="16:9" />
    <Figure src="/fig-svg/ex-onscreen-scope.svg" alt="Cinemascope end card" mono="CINEMASCOPE" />
    <Figure src="/fig-svg/ex-onscreen-spheres.svg" alt="SPHERES circular icon" mono="SPHERES — icon" />
  </div>
  <p class="block-label">{t.print}</p>
  <div class="fig-grid cols-2">
    <figure class="fig">
      <div class="fig-plate" style="--plate-h: 460px;">
        <img src="/fig-svg/ex-billing.svg" alt="Billing statement example" loading="lazy" />
      </div>
      <figcaption class="fig-cap"><span class="cap-title">Billing Statement</span></figcaption>
    </figure>
    <figure class="fig">
      <div class="fig-plate" style="--plate-h: 460px;">
        <img src="/fig-svg/ex-resume.svg" alt="Resume example" loading="lazy" />
      </div>
      <figcaption class="fig-cap"><span class="cap-title">Resume</span></figcaption>
    </figure>
    <figure class="fig">
      <div class="fig-plate" style="--plate-h: 620px;">
        <img src="/fig-svg/ex-cards.svg" alt="Business cards example" loading="lazy" />
      </div>
      <figcaption class="fig-cap"><span class="cap-title">Business cards</span></figcaption>
    </figure>
    <figure class="fig">
      <div class="fig-plate" style="--plate-h: 330px;">
        <img src="/fig-svg/ex-airplane.svg" alt="Aircraft livery example" loading="lazy" />
      </div>
      <figcaption class="fig-cap"><span class="cap-title">Aircraft livery</span></figcaption>
    </figure>
  </div>
  <p class="block-label">{en ? 'Banner assets' : 'Banner assets / バナー素材'}</p>
  <div class="asset-grid">
    {
      getStaticGroups('banner').map((group) => {
        const preview = group.files.find((file) => file.ext === 'jpg') ?? group.files[0];
        return (
          <div class="asset-card">
            <div class="fig-plate asset-plate">
              <img src={preview.url} alt={group.base} loading="lazy" />
            </div>
            <div class="asset-foot">
              <span class="asset-label">{group.base}</span>
              <div class="asset-actions">
                {group.files.map((file) => (
                  <a class="chip-btn" href={file.url} download={file.name}>
                    {file.ext.toUpperCase()} ↓ <span class="chip-size">{formatSize(file.size)}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
