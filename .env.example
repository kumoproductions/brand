# Cloudflare R2 Configuration
# Copy this file to .env and fill in your R2 credentials

# R2 Account ID (found in Cloudflare Dashboard > R2 > Overview)
R2_ACCOUNT_ID=your_account_id_here

# R2 Access Key ID (create in Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id_here

# R2 Secret Access Key (create in Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# R2 Bucket Name
R2_BUCKET_NAME=your_bucket_name_here

# Optional: Custom domain URL (if you have a custom domain configured)
# R2_PUBLIC_URL=https://your-custom-domain.com
